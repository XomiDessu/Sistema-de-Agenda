# Configuración de Agenda de Citas MVP
HOST=0.0.0.0
PORT=8000
APP_NAME=Agenda de Citas
DB_PATH=data/agenda.db

# En producción detrás de HTTPS cambia esto a true
COOKIE_SECURE=false

# Aprovisionamiento seguro del administrador inicial (opcional).
# Si los dejas vacíos, el servidor generará un SETUP_TOKEN de un solo uso en la consola al arrancar.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
ADMIN_EMAIL=
SETUP_TOKEN=

# Correo SMTP real (opcional; si SMTP_HOST está vacío, inicia en modo demostración)
# Ejemplo Gmail: smtp.gmail.com, puerto 587, TLS=true y contraseña de aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=true
